# Секретный ключ. Не отправляйте .env в GitHub.
DASHSCOPE_API_KEY=

# intl — Сингапур/международный аккаунт; mainland — Пекин.
DASHSCOPE_REGION=intl

# Заполните, если ваш аккаунт использует выделенный Workspace endpoint.
DASHSCOPE_WORKSPACE_ID=

DASHSCOPE_MODEL=qwen3.8-livetranslate-flash-realtime

# Полный URL нужен только для нестандартного подключения. Обычно оставьте пустым.
DASHSCOPE_WS_URL=
